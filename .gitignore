# ---- 依赖 ----
node_modules/

# ---- 构建产物 ----
dist/
dist-ssr/
coverage/
*.tsbuildinfo
# Android APK：打包脚本会复制一份到仓库根目录（Conceit-<版本>-release.apk）
Conceit-*-release.apk

# ---- Rust / Tauri（构建产物与生成文件全部位于 target/）----
target/
src-tauri/target/
# 仅 gen/schemas 是每次构建重新生成的配置；gen/android、gen/apple 是
# 需要提交维护的移动端工程，不能忽略
src-tauri/gen/schemas/
# Android 签名配置：含密钥路径与密码，切勿提交（密钥本身在仓库外的 ~/.conceit/）
src-tauri/gen/android/keystore.properties
src-tauri/gen/android/local.properties
src-tauri/gen/android/app/tauri.properties

# ---- 环境变量（可能含密钥，切勿提交；示例文件除外）----
.env
.env.*
!.env.example

# ---- 日志 ----
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- 编辑器 / 操作系统 ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- 临时 / 备份文件 ----
*.tmp
*.temp
*.bak
*.orig
